[Unit]
Description=Utah weekly countme analytics ping
Documentation=https://projectbluefin.io/analytics
After=network-online.target
Wants=network-online.target

# The timer starts the service directly; [Install] WantedBy is not needed for a
# timer-driven oneshot (kept only where a unit is started on its own).

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/utah-countme
StandardOutput=journal
StandardError=journal
# Sandboxed best-effort oneshot: no persistent privileges, read-only view of
# most of the filesystem, private temp, and its state dir is the epoch file.
DynamicUser=yes
StateDirectory=utah-countme
ProtectSystem=strict
ProtectHome=true
PrivateTmp=yes
NoNewPrivileges=yes
